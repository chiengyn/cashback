# Postgres. Trên Vercel dùng URL của connection pooler (Neon: -pooler, Supabase: cổng 6543).
DATABASE_URL=postgres://postgres:test@localhost:55432/hoantien

# Chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
CRON_SECRET=
AUTH_SECRET=
# Mật khẩu trang /admin (tên đăng nhập: admin)
ADMIN_PASSWORD=

# mock: không gọi API sàn (mặc định khi chạy local). live: gọi API thật (mặc định ở production).
AFFILIATE_MODE=mock
SHOPEE_APP_ID=
SHOPEE_SECRET=

# console: in mã OTP ra log. Chưa có nhà cung cấp SMS thật.
SMS_PROVIDER=console

MIN_WITHDRAWAL=50000
APPROVAL_HOLD_DAYS=30
